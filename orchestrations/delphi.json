{
  "name": "Classical Delphi",
  "version": "1.0",
  "author": "Decidero Engine",
  "citation": "Linstone, H. A., and Turoff, M., editors. The Delphi Method: Techniques and Applications. Addison-Wesley, 1975.",
  "metadata": {
    "notes": "Canary: Oracular Quokka. Construction summary: a Phase 6 reference Delphi process starts with brainstorming, then iterates rank-order voting with Delphi statistical aggregation and IQR stability convergence over at most four rounds. Source citation: Linstone and Turoff, The Delphi Method, Addison-Wesley, 1975.",
    "thinklets": [
      "FreeBrainstorm",
      "Ranked Evaluation",
      "Delphi statistical feedback"
    ],
    "collaboration_patterns": [
      "Generate",
      "Evaluate",
      "Build Consensus"
    ],
    "deliverables": [
      "Converged ranked list",
      "Per-item median and IQR statistics",
      "Per-participant outlier annotations"
    ],
    "group_size_range": {
      "min": 4,
      "max": 25
    },
    "typical_duration_minutes": {
      "min": 45,
      "max": 120
    }
  },
  "steps": [
    {
      "type": "sequence",
      "steps": [
        {
          "type": "activity",
          "tool_type": "brainstorming",
          "title": "Round 1: Generate Delphi Items",
          "config": {
            "allow_anonymous": true,
            "allow_subcomments": false,
            "auto_jump_new_ideas": true
          }
        },
        {
          "type": "iterate",
          "max_rounds": 4,
          "convergence_predicate": {
            "name": "iqr_stability",
            "config": {
              "threshold": 0.15
            }
          },
          "bundle_transform": {
            "name": "delphi_statistical_aggregation",
            "config": {}
          },
          "round_gate": {
            "decision": {
              "prompt": "Run another round, or conclude the method?",
              "options": ["continue", "conclude"],
              "report": {
                "summarizer": "delphi_round_agreement",
                "config": {},
                "audience": "facilitator"
              },
              "recommender": {
                "source": "ai",
                "metrics": ["delphi_round_agreement"],
                "rule": [
                  { "when": "converged", "recommend": "conclude" },
                  { "default": "continue" }
                ]
              }
            }
          },
          "steps": [
            {
              "type": "sequence",
              "steps": [
                {
                  "type": "activity",
                  "tool_type": "rank_order_voting",
                  "title": "Rank Delphi Items",
                  "transform_input": "previous_round_feedback",
                  "config": {
                    "ideas": [],
                    "randomize_order": true,
                    "show_results_immediately": false,
                    "allow_reset": true
                  }
                },
                {
                  "type": "facilitator-decision",
                  "prompt": "These items had the widest spread last round. How many of the least-agreed ideas do you want to open for comment before the group ranks again?",
                  "options": ["open_comments", "skip_comments"],
                  "report": {
                    "summarizer": "delphi_round_agreement",
                    "config": { "feedback_selection": true },
                    "audience": "facilitator"
                  }
                },
                {
                  "type": "activity",
                  "tool_type": "brainstorming",
                  "title": "Comment on Disputed Ideas",
                  "config": {
                    "seed_from_input": true,
                    "allow_new_ideas": false,
                    "allow_subcomments": true,
                    "allow_anonymous": true,
                    "comment_scope": "selected",
                    "feedback_policy": {
                      "comment_selection": {
                        "strategy": "adaptive_least_converged",
                        "default_fraction": 0.25,
                        "max_fraction": 0.5,
                        "low_disagreement_fraction": 0.0,
                        "moderate_disagreement_fraction": 0.15,
                        "high_disagreement_fraction": 0.25,
                        "min_items_when_disputed": 1,
                        "allow_skip": true
                      },
                      "agreement_bands": {
                        "score_source": "iqr",
                        "green_max": 1.0,
                        "yellow_max": 2.0
                      },
                      "participant_prompt": "These items had the widest spread in the last ranking. Add brief reasons or considerations before the group ranks again.",
                      "facilitator_prompt": "Choose how many of the least-agreed items to open for comments before reranking."
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "type": "activity",
          "tool_type": "report",
          "title": "Final Report",
          "config": {}
        }
      ]
    }
  ]
}
