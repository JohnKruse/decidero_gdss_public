{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://decidero.local/schemas/orchestration.schema.json",
  "title": "Process Orchestration Document Schema",
  "description": "Insolent Metronome Phase 4 schema for the collaboration process orchestration grammar, supporting sequences, iterations, and step-kinds.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "author",
    "citation",
    "metadata",
    "steps"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "citation": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thinklets",
        "collaboration_patterns",
        "deliverables",
        "group_size_range",
        "typical_duration_minutes"
      ],
      "properties": {
        "thinklets": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "collaboration_patterns": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "deliverables": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "group_size_range": {
          "$ref": "#/$defs/non_negative_range"
        },
        "typical_duration_minutes": {
          "$ref": "#/$defs/non_negative_range"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "report": {
      "description": "A named summarizer (the human-facing dual of a convergence predicate) rendered to an audience. See HICSS outline L.2.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summarizer",
        "audience"
      ],
      "properties": {
        "summarizer": {
          "type": "string",
          "minLength": 1
        },
        "config": {
          "type": "object"
        },
        "audience": {
          "enum": [
            "facilitator",
            "participants"
          ]
        }
      }
    },
    "recommender": {
      "description": "Layer-A metric references + a Layer-B declarative guard rule that resolves a recommended option over the scalar namespace. See HICSS outline L.3. Conditions are bounded to comparisons/booleans over scalar metrics; the runtime loader rejects unsafe conditions.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule"
      ],
      "properties": {
        "metrics": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rule": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "oneOf": [
              {
                "additionalProperties": false,
                "required": [
                  "when",
                  "recommend"
                ],
                "properties": {
                  "when": {
                    "type": "string",
                    "minLength": 1
                  },
                  "recommend": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              {
                "additionalProperties": false,
                "required": [
                  "default"
                ],
                "properties": {
                  "default": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          }
        }
      }
    },
    "facilitator_decision_body": {
      "description": "The shared facilitator-decision shape, reused by the facilitator-decision step and by an iterate's round_gate.decision (unification, HICSS outline L.1).",
      "type": "object",
      "required": [
        "prompt",
        "options"
      ],
      "properties": {
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "context_bundle_keys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "report": {
          "$ref": "#/$defs/report"
        },
        "recommender": {
          "$ref": "#/$defs/recommender"
        }
      }
    },
    "non_negative_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "$comment": "The 'conditional' step kind is reserved and intentionally absent from this enum. Its shape is documented in the conditional allOf branch below for forward compatibility, but the runtime loader (app/services/orchestration_loader.py) and this schema both reject documents that use it. A future minor release will lift the rejection.",
          "enum": [
            "sequence",
            "iterate",
            "activity",
            "facilitator-decision",
            "ai-decision"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "sequence"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "type",
              "steps"
            ],
            "properties": {
              "type": {
                "const": "sequence"
              },
              "steps": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/step"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "iterate"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "type",
              "steps",
              "max_rounds",
              "convergence_predicate",
              "bundle_transform"
            ],
            "properties": {
              "type": {
                "const": "iterate"
              },
              "steps": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/step"
                }
              },
              "max_rounds": {
                "type": "integer",
                "minimum": 1
              },
              "convergence_predicate": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "config"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "config": {
                    "type": "object"
                  }
                }
              },
              "bundle_transform": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "config"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "config": {
                    "type": "object"
                  }
                }
              },
              "round_gate": {
                "description": "Optional facilitator round-gate. When present the engine pauses at each round boundary below max_rounds for a decision, embedding a full facilitator-decision body (unification, see HICSS outline L.1). The recommended option is resolved at runtime from the decision's recommender rule, so it is not authored here. The cap remains a hard backstop. The former {mode, recommendation} enum form was removed.",
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "decision"
                ],
                "properties": {
                  "decision": {
                    "$ref": "#/$defs/facilitator_decision_body"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "conditional"
              }
            }
          },
          "then": {
            "description": "Reserved and deferred step primitive for future conditional execution. Currently unsupported at runtime.",
            "additionalProperties": true,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "conditional"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "activity"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "type",
              "tool_type",
              "title"
            ],
            "properties": {
              "type": {
                "const": "activity"
              },
              "tool_type": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "config": {
                "type": "object"
              },
              "transform_input": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "facilitator-decision"
              }
            }
          },
          "then": {
            "allOf": [
              { "$ref": "#/$defs/facilitator_decision_body" },
              {
                "properties": {
                  "type": {
                    "const": "facilitator-decision"
                  }
                },
                "required": [
                  "type"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "ai-decision"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "type",
              "prompt_template",
              "output_schema",
              "review_required"
            ],
            "properties": {
              "type": {
                "const": "ai-decision"
              },
              "prompt_template": {
                "type": "string",
                "minLength": 1
              },
              "output_schema": {
                "type": "object"
              },
              "review_required": {
                "type": "boolean"
              },
              "context_bundle_keys": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      ]
    }
  }
}
